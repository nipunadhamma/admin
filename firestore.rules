rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /* =========================================================
       AUTHENTICATION
    ========================================================= */

    function signedIn() {
      return request.auth != null;
    }


    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }


    /* =========================================================
       ADMIN
    ========================================================= */

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "kalawanesangamaji@gmail.com"
        && request.auth.token.email_verified == true;
    }


    /* =========================================================
       1. TOURIST PROFILES
       lankaQuestTourists/{uid}
    ========================================================= */

    match /lankaQuestTourists/{uid} {

      allow read: if isAdmin()
        || isOwner(uid);


      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid;


      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.accountType == resource.data.accountType
        );


      allow delete: if false;
    }


    /* =========================================================
       2. GUIDE PROFILES
       lankaQuestGuides/{uid}
    ========================================================= */

    match /lankaQuestGuides/{uid} {

      /*
        Logged-in users can read guide profiles.
        This is required by Find Guides.
      */

      allow read: if signedIn();


      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.accountType == "guide";


      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.accountType == resource.data.accountType
        );


      allow delete: if false;
    }


    /* =========================================================
       3. TOURIST TRIPS
       lankaQuestTouristTrips/{tripId}

       Current architecture:
       tripId = Tourist Firebase UID
    ========================================================= */

    match /lankaQuestTouristTrips/{tripId} {

      allow create: if signedIn()
        && request.resource.data.touristId == request.auth.uid;


      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.touristId == request.auth.uid
        );


      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.touristId == request.auth.uid
          && request.resource.data.touristId == resource.data.touristId
        );


      allow delete: if false;
    }


    /* =========================================================
       4. QUOTATION REQUESTS
       lankaQuestQuotationRequests/{requestId}

       requestId = Firestore auto-generated document ID
    ========================================================= */

    match /lankaQuestQuotationRequests/{requestId} {


      /* -------------------------------------------------------
         CREATE
      ------------------------------------------------------- */

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.touristId == request.auth.uid
        );


      /* -------------------------------------------------------
         READ

         Tourist:
           Own requests

         Guide:
           Assigned requests

         Admin:
           All requests
      ------------------------------------------------------- */

      allow read: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.touristId == request.auth.uid
            || resource.data.guideId == request.auth.uid
            || resource.data.assignedGuideId == request.auth.uid
          )
        );


      /* -------------------------------------------------------
         UPDATE

         Admin:
           All requests

         Tourist:
           Own request

         Guide:
           Assigned request

         Ownership identity cannot be transferred.
      ------------------------------------------------------- */

      allow update: if isAdmin()
        || (
          signedIn()
          && (
            (
              resource.data.touristId == request.auth.uid
              && request.resource.data.touristId
                   == resource.data.touristId
            )

            ||

            (
              resource.data.guideId == request.auth.uid
              && request.resource.data.touristId
                   == resource.data.touristId
            )

            ||

            (
              resource.data.assignedGuideId == request.auth.uid
              && request.resource.data.touristId
                   == resource.data.touristId
            )
          )
        );


      /* -------------------------------------------------------
         DELETE

         Tourist can delete OWN quotation request.
      ------------------------------------------------------- */

      allow delete: if signedIn()
        && resource.data.touristId == request.auth.uid;
    }


    /* =========================================================
       5. QUOTATIONS
       lankaQuestQuotations/{quotationId}

       quotationId = Firestore auto-generated document ID
    ========================================================= */

    match /lankaQuestQuotations/{quotationId} {


      /* -------------------------------------------------------
         CREATE

         Guide creates own quotation.

         Admin can create if required.
      ------------------------------------------------------- */

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.guideId == request.auth.uid
        );


      /* -------------------------------------------------------
         READ

         Tourist:
           Own quotations

         Guide:
           Own quotations

         Admin:
           All quotations
      ------------------------------------------------------- */

      allow read: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.touristId == request.auth.uid
            || resource.data.guideId == request.auth.uid
          )
        );


      /* -------------------------------------------------------
         UPDATE - TOURIST

         Tourist can update ONLY:

           status
           updatedAt

         Tourist ID cannot change.
         Guide ID cannot change.

         This specifically supports:

           status = "accepted"
           updatedAt = serverTimestamp()
      ------------------------------------------------------- */

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.touristId == request.auth.uid
          && request.resource.data.touristId
               == resource.data.touristId
          && request.resource.data.guideId
               == resource.data.guideId
          && request.resource.data.diff(
               resource.data
             ).affectedKeys().hasOnly([
               "status",
               "updatedAt"
             ])
        )

        ||

        (
          signedIn()
          && resource.data.guideId == request.auth.uid
          && request.resource.data.guideId
               == resource.data.guideId
          && request.resource.data.touristId
               == resource.data.touristId
        );


      /* -------------------------------------------------------
         DELETE - IMPORTANT

         Tourist:
           Can DELETE their own quotation.

         Guide:
           Can DELETE their own quotation.

         Another user:
           Cannot delete it.
      ------------------------------------------------------- */

      allow delete: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.touristId == request.auth.uid
            || resource.data.guideId == request.auth.uid
          )
        );
    }


    /* =========================================================
       DEFAULT DENY
    ========================================================= */

    match /{document=**} {

      allow read, write: if false;
    }

  }
}